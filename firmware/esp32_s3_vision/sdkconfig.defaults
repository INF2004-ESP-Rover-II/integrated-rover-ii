# Target and PSRAM (N16R8 = 16MB flash / 8MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Give the HTTP server + Wi-Fi + USB host stacks enough room
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_CTRL_TRANSFER_DATA_MAX_BYTES=2048

# Full CPU speed: on-board JPEG decoding and marker detection need it
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
